generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusReserva {
  PENDENTE
  CONFIRMADA
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

enum PapelUsuario {
  CLIENTE
  OPERADOR
  ADMIN
}

model Conta {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(150)
  papel     PapelUsuario @default(ADMIN)
  pessoas   Usuario[]
  espacos   Espaco[]
  reservas  Reserva[]
  historicosReserva HistoricoReserva[] @relation("AutorHistoricoReserva")
  credencial CredencialUsuario?
  sessoes    SessaoUsuario[]

  @@map("contas")
}

model Usuario {
  id        Int       @id @default(autoincrement())
  contaId   Int       @map("conta_id")
  nome      String    @db.VarChar(150)
  conta     Conta     @relation(fields: [contaId], references: [id], onDelete: Restrict)
  reservas  Reserva[]

  @@unique([id, contaId])
  @@index([contaId])
  @@map("usuarios")
}

model CredencialUsuario {
  contaId   Int      @id @map("conta_id")
  email     String   @unique @db.VarChar(254)
  senhaHash String   @map("senha_hash") @db.VarChar(255)
  conta     Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@map("credenciais_usuarios")
}

model SessaoUsuario {
  id        Int      @id @default(autoincrement())
  contaId   Int      @map("conta_id")
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiraEm  DateTime @map("expira_em")
  criadaEm  DateTime @default(now()) @map("criada_em")
  conta     Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, expiraEm])
  @@map("sessoes_usuarios")
}

model Espaco {
  id           Int       @id @default(autoincrement())
  contaId      Int       @map("conta_id")
  conta        Conta     @relation(fields: [contaId], references: [id], onDelete: Restrict)
  nome         String    @db.VarChar(150)
  descricao    String    @default("") @db.Text
  capacidade   Int
  localizacao  String    @default("") @db.VarChar(255)
  valorPorHora Decimal   @db.Decimal(10, 2) @map("valor_por_hora")
  reservas     Reserva[]

  @@unique([id, contaId])
  @@index([contaId])
  @@map("espacos")
}

model Reserva {
  id                     Int           @id @default(autoincrement())
  contaId                Int           @map("conta_id")
  conta                  Conta         @relation(fields: [contaId], references: [id], onDelete: Restrict)
  usuarioId              Int           @map("usuario_id")
  espacoId               Int           @map("espaco_id")
  data                   DateTime      @db.Date
  horarioInicio          String        @db.VarChar(5) @map("horario_inicio")
  horarioFim             String        @db.VarChar(5) @map("horario_fim")
  status                 StatusReserva @default(PENDENTE)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  checkInReal            DateTime?     @map("check_in_real")
  checkOutReal           DateTime?     @map("check_out_real")
  tempoExcedenteMinutos  Int?          @map("tempo_excedente_minutos")
  valorExcedente         Decimal?      @db.Decimal(10, 2) @map("valor_excedente")
  usuario                Usuario       @relation(fields: [usuarioId, contaId], references: [id, contaId], onDelete: Restrict)
  espaco                 Espaco        @relation(fields: [espacoId, contaId], references: [id, contaId], onDelete: Restrict)
  historicos             HistoricoReserva[]

  @@index([usuarioId])
  @@index([contaId])
  @@index([espacoId, data])
  @@map("reservas")
}

model HistoricoReserva {
  idRegistro       Int           @id @default(autoincrement()) @map("id_registro")
  reservaId        Int           @map("reserva_id")
  estadoAnterior   StatusReserva? @map("estado_anterior")
  novoEstado       StatusReserva @map("novo_estado")
  autorId          Int?          @map("autor_id")
  justificativa    String        @db.Text
  timestamp        DateTime      @default(now())
  reserva          Reserva       @relation(fields: [reservaId], references: [id], onDelete: Restrict)
  autor            Conta?        @relation("AutorHistoricoReserva", fields: [autorId], references: [id], onDelete: Restrict)

  @@index([reservaId, timestamp])
  @@map("historico_reservas")
}
